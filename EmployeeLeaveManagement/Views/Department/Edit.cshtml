@model EmployeeLeaveManagement.Models.Department

@{
    ViewData["Title"] = "Edit Department";
}

<h2>Edit Department</h2>

<hr />

<form asp-action="Edit" method="post">

    <input type="hidden"
           asp-for="DepartmentId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">

        <label asp-for="DepartmentName"
               class="form-label">
        </label>

        <input asp-for="DepartmentName"
               class="form-control" />

        <span asp-validation-for="DepartmentName"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label>
            <input asp-for="IsActive" />
            Active
        </label>

    </div>

    <button type="submit"
            class="btn btn-success">
        Update
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>