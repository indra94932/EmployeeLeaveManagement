@model EmployeeLeaveManagement.Models.Department

@{
    ViewData["Title"] = "Deactivate Department";
}

<h2>Deactivate Department</h2>

<div class="alert alert-warning">
    Are you sure you want to deactivate this department?
</div>

<p>
    <strong>Department:</strong>
    @Model.DepartmentName
</p>

<form method="post"
      action="/Department/DeleteConfirmed">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="id"
           value="@Model.DepartmentId" />

    <button type="submit"
            class="btn btn-danger">
        Yes, Deactivate
    </button>

    <a href="/Department"
       class="btn btn-secondary">
        Cancel
    </a>
</form>