@model EmployeeLeaveManagement.Models.Department

@{
    ViewData["Title"] = "Department Details";
}

<h2>Department Details</h2>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Department ID
    </dt>

    <dd class="col-sm-9">
        @Model.DepartmentId
    </dd>

    <dt class="col-sm-3">
        Department Name
    </dt>

    <dd class="col-sm-9">
        @Model.DepartmentName
    </dd>

    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @(Model.IsActive ? "Active" : "Inactive")
    </dd>

</dl>

<a asp-action="Edit"
   asp-route-id="@Model.DepartmentId"
   class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>