<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Employee Leave Management
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    Employee Leave Management

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarContent">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    Dashboard

                                </a>

                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Employee"
                                       asp-action="Index">

                                        Employees

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Department"
                                       asp-action="Index">

                                        Departments

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="LeaveType"
                                       asp-action="Index">

                                        Leave Types

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Leave"
                                       asp-action="Index">

                                        Leave Applications

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="LeaveApproval"
                                       asp-action="Index">

                                        Leave Approval

                                    </a>

                                </li>
                            }

                            @if (User.IsInRole("Employee"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Leave"
                                       asp-action="Create">

                                        Apply Leave

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Leave"
                                       asp-action="Index">

                                        My Leaves

                                    </a>

                                </li>
                            }

                        </ul>

                        <span class="navbar-text text-white me-3">

                            Welcome,
                            @User.Identity?.Name

                        </span>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-light">

                                Logout

                            </button>

                        </form>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>

                        </ul>
                    }

                </div>

            </div>

        </nav>

    </header>

    <main class="container mt-4">

        @RenderBody()

    </main>

    <footer class="border-top footer text-muted mt-5">

        <div class="container">

            &copy; 2026 - Employee Leave Management

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>